{
  "method": "FlawPrint",
  "datasets": [
    "weibo",
    "weibo21",
    "finefake"
  ],
  "hardware": {
    "gpu": "NVIDIA GeForce RTX 4090",
    "gpu_count": 1,
    "device": "cuda:0"
  },
  "seeds": [
    42,
    52,
    3047,
    3407
  ],
  "semantic_backbone": {
    "epochs": 50,
    "batch_size": 64,
    "learning_rate": 0.0001,
    "max_text_length": 197,
    "early_stopping_patience": 5,
    "weight_decay": 5e-05,
    "embedding_dimension": 768
  },
  "partitions": {
    "weibo": {
      "train": "./data/train_origin.csv",
      "validation": "./data/val_origin.csv",
      "test": "./data/test_origin.csv",
      "domains": 9
    },
    "weibo21": {
      "train": "./weibo21/train_datasets.xlsx",
      "validation": "./weibo21/val_datasets.xlsx",
      "test": "./weibo21/test_datasets.xlsx",
      "domains": 9
    },
    "finefake": {
      "train": "./FineFake/train.csv",
      "validation": "./FineFake/val.csv",
      "test": "./FineFake/test.csv",
      "domains": 7,
      "split_ratio": [
        0.6,
        0.2,
        0.2
      ],
      "split_seed": 3407
    }
  },
  "metrics": [
    "accuracy",
    "fake_precision",
    "fake_recall",
    "fake_f1",
    "real_precision",
    "real_recall",
    "real_f1",
    "macro_f1"
  ],
  "neural_extension": {
    "name": "FlawPrint-CRA",
    "entry_point": "deep.py",
    "config": "./configs/neural.json",
    "frozen_encoders": [
      "bert",
      "mae",
      "clip"
    ],
    "optional_encoder": "forensic",
    "modes": [
      "coupled",
      "unbiased",
      "independent",
      "deep",
      "concat",
      "broadcast",
      "diagonal",
      "shuffled"
    ],
    "source_reference": "group cross-fitting",
    "target_reference": "independent unlabeled profile rows",
    "target_labels_used_for_fitting": false,
    "relation_operator": "content-conditioned-reference-v2",
    "fixed_checkpoint_intervention": "deep.py predict --explain"
  }
}
