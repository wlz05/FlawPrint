{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlawPrint canonical manifest row",
  "type": "object",
  "required": ["id", "image", "text", "domain", "platform", "group", "split"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "image": {"type": "string", "description": "One local relative path or an empty string for text-only input"},
    "text": {"type": "string"},
    "domain": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "group": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "calibration", "profile", "test", "unspecified"]},
    "label": {"type": "integer", "enum": [0, 1], "description": "Zero is real and one is fake"},
    "has_image": {"type": "boolean"},
    "semantic_logit": {"type": "number", "description": "Finite fake-positive external score"},
    "patch_signs_valid_after_attack": {"type": "boolean"}
  },
  "allOf": [{"if": {"properties": {"split": {"const": "profile"}}, "required": ["split"]}, "then": {"not": {"required": ["label"]}}}],
  "additionalProperties": true
}
